<?xml version="1.0" encoding="utf-8"?>
<form>
	<fields name="filter">
		<field
			name="search"
			type="text"
			label="COM_BANNERS_SEARCH_IN_TITLE"
			hint="JSEARCH_FILTER"
			class="js-stools-search-string"
		/>
		<field
			name="published"
			type="status"
			label="JOPTION_SELECT_PUBLISHED"
			statuses="0,1"
			description="JOPTION_SELECT_PUBLISHED_DESC"
			onchange="this.form.submit();"
			>
			<option value="">JOPTION_SELECT_PUBLISHED</option>
		</field>
        <field
			name="language"
			type="contentlanguage"
			label="JOPTION_FILTER_LANGUAGE"
			description="JOPTION_FILTER_LANGUAGE_DESC"
			onchange="this.form.submit();"
			>
			<option value="">JOPTION_SELECT_LANGUAGE</option>
			<option value="*">JALL</option>
		</field>
        <field
			name="category_id"
			type="category"
			label="JOPTION_FILTER_CATEGORY"
			extension="com_newsworld"
			onchange="this.form.submit();"
			published="0,1,2"
			>
			<option value="">JOPTION_SELECT_CATEGORY</option>
		</field>
	</fields>
	<fields name="list">
        <field
			name="fullordering"
			type="list"
			label="COM_NEWSWORLD_LIST_FULL_ORDERING"
			description="COM_NEWSWORLD_LIST_FULL_ORDERING_DESC"
			onchange="this.form.submit();"
			default="lft ASC"
			>
			<option value="">JGLOBAL_SORT_BY</option>
			<option value="lft ASC">COM_NEWSWORLD_ORDERING_ASC</option>
			<option value="lft DESC">COM_NEWSWORLD_ORDERING_DESC</option>
            <option value="title ASC">COM_NEWSWORLD_TITLE_ASC</option>
			<option value="title DESC">COM_NEWSWORLD_TITLE_DESC</option>
			<option value="id ASC">JGRID_HEADING_ID_ASC</option>
			<option value="id DESC">JGRID_HEADING_ID_DESC</option>
			<option value="published ASC">COM_NEWSWORLD_PUBLISHED_ASC</option>
			<option value="published DESC">COM_NEWSWORLD_PUBLISHED_DESC</option>
            <option value="author ASC">COM_NEWSWORLD_AUTHOR_ASC</option>
			<option value="author DESC">COM_NEWSWORLD_AUTHOR_DESC</option>
			<option value="created ASC">COM_NEWSWORLD_CREATED_ASC</option>
			<option value="created DESC">COM_NEWSWORLD_CREATED_DESC</option>
            <option value="language ASC">COM_NEWSWORLD_LANGUAGE_ASC</option>
			<option value="language DESC">COM_NEWSWORLD_LANGUAGE_DESC</option>
            <option value="access ASC">COM_NEWSWORLD_ACCESS_ASC</option>
			<option value="access DESC">COM_NEWSWORLD_ACCESS_DESC</option>
			<option value="association ASC">COM_NEWSWORLD_ASSOCIATION_ASC</option>
			<option value="association DESC">COM_NEWSWORLD_ASSOCIATION_DESC</option>
		</field>
		<field
			name="limit"
			type="limitbox"
			class="input-mini"
			default="25"
			label="COM_CONTENT_LIST_LIMIT"
			description="COM_NEWSWORLD_LIST_LIMIT_DESC"
			onchange="this.form.submit();"
		/>
	</fields>
</form>