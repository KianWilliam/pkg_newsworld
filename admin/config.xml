<?xml version="1.0" encoding="utf-8"?>
<config>
<fieldset
		name="newsworld"
		label="JGLOBAL_NEWSWORLD"
		description="COM_NEWSWORLD_CONFIG_NEWSWORLD_SETTINGS_DESC"
		>
<field
			name="save_history"
			type="radio"
			label="JGLOBAL_SAVE_HISTORY_OPTIONS_LABEL"
			layout="joomla.form.field.radio.switcher"
			default="0"
			>
			<option value="0">JNO</option>
			<option value="1">JYES</option>
		</field>

		<field
			name="history_limit"
			type="number"
			label="JGLOBAL_HISTORY_LIMIT_OPTIONS_LABEL"
			filter="integer"
			validate="number"
			min="0"
			default="10"
			showon="save_history:1"
		/>
			</fieldset>

 <fields name="params">
		<fieldset
				name="params"
				label="JGLOBAL_FIELDSET_DISPLAY_OPTIONS"
		>
			<field
					name="show_category"
					type="list"
					label="COM_NEWSWORLD_NEWSWORLD_FIELD_SHOW_CATEGORY_LABEL"
					description="COM_NEWSWORLD_NEWSWORLD_FIELD_SHOW_CATEGORY_DESC"
					default=""
			>				
				<option value="0">JHIDE</option>
				<option value="1">JSHOW</option>
			</field>
		</fieldset>
	</fields>
	
    <fieldset
		name="permissions"
		label="JCONFIG_PERMISSIONS_LABEL"
		description="JCONFIG_PERMISSIONS_DESC"
	>
		<field
			name="rules"
			type="rules"
			label="JCONFIG_PERMISSIONS_LABEL"
			class="inputbox"
			validate="rules"
			filter="rules"
			component="com_newsworld"
			section="component"
		/>
	</fieldset>
</config>